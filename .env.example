# Salin file ini jadi ".env" lalu isi dengan kredensial project Supabase kamu.
# Ambil di: Supabase Dashboard > Project Settings > API
#   VITE_SUPABASE_URL      = "Project URL"
#   VITE_SUPABASE_ANON_KEY = "anon / public" key  (BUKAN service_role)
#
# Setelah mengubah .env, dev server WAJIB di-restart (Ctrl+C lalu `npm run dev`).

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
